{
  "name": "baddev",
  "version": "1.4.0",
  "description": "Code Without Mercy - Editor web de codigo y entorno educativo",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "python:bridge": "node bridge/python-bridge.cjs",
    "desktop:dev": "vite build && electron . --debug",
    "desktop:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "autoprefixer": "^10.6.1",
    "codemirror": "^6.0.2",
    "postcss": "^8.5.31",
    "postcss-nested": "^9.0.1",
    "prettier": "^3.9.10",
    "pyodide": "^314.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.baddev.app",
    "productName": "BadDev",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/favicon.ico",
      "package.json"
    ],
    "directories": {
      "output": "dist_desktop"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "artifactName": "BadDev-${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "BadDev"
}